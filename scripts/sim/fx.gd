static func sin_d(deg: int) -> int:
	return SIN[posmod(deg, 360)]

static func cos_d(deg: int) -> int:
	return SIN[posmod(deg + 90, 360)]

static func isqrt(n: int) -> int:
	if n <= 0:
		return 0
	var x := n
	var y := (x + 1) / 2
	while y < x:
		x = y
		y = (x + n / x) / 2
	return x

## Move v toward 0 by amount (both ints).
static func approach0(v: int, amount: int) -> int:
	if v > 0:
		return maxi(0, v - amount)
	if v < 0:
		return mini(0, v + amount)
	return 0

static func approach(v: int, target: int, amount: int) -> int:
	if v < target:
		return mini(target, v + amount)
	return maxi(target, v - amount)

## Circle (cx, cy, r) vs axis-aligned rect test.
static func circle_rect(cx: int, cy: int, r: int, rx0: int, ry0: int, rx1: int, ry1: int) -> bool:
	var nx := clampi(cx, rx0, rx1)
	var ny := clampi(cy, ry0, ry1)
	var dx := cx - nx
	var dy := cy - ny
	return dx * dx + dy * dy <= r * r
